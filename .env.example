# 선택 사항 — 기본 구조(구조 B)에서는 필요 없다.
# 수집·번역·요약은 Claude Code CLI가 대행하므로 아래 키 없이도 동작한다.
#
# 서버가 '직접' 요약(/enrich)·번역(/translate)을 처리하게 하려면 아래를 설정:
#   1) pip install anthropic
#   2) 이 파일을 .env 로 복사하고 키를 채운다 (.env 는 커밋되지 않음)

# ANTHROPIC_API_KEY=sk-ant-...

# 모델 (기본값 예시 — 네 계정에서 쓸 수 있는 모델로)
# AHK_SUMMARY_MODEL=claude-opus-5-5
# AHK_TRANSLATE_MODEL=claude-haiku-5-5

# 아카이브 저장 루트 (기본: server/data/archive)
# AHK_ARCHIVE=
